# Folk Linux — x86_64 paket listesi (FAZ 1: minimal, kompakt)
# Her satır bir pacman paketi. Yorum satırları ( # ) yoksayılır.
# HEDEF: ISO < 2 GB (GitHub Release limiti) — gereksiz ağırlık yok.
# Not: Yalnızca Resmi Arch depolarında (core/extra/multilib) bulunan paketler.

# ── Çekirdek sistem ──────────────────────────────────────────────
base
linux
linux-firmware
systemd
systemd-sysvcompat

# ── Boot / initramfs ─────────────────────────────────────────────
mkinitcpio
grub
efibootmgr
dosfstools
mtools
syslinux
intel-ucode
amd-ucode

# ── Ağ ──────────────────────────────────────────────────────────
networkmanager
network-manager-applet
dnsutils
curl
wget
rsync

# ── Depolama ────────────────────────────────────────────────────
btrfs-progs
xfsprogs
ntfs-3g
exfatprogs
lvm2
cryptsetup
util-linux

# ── Terminal ────────────────────────────────────────────────────
bash
zsh
nano
man-db

# ── KDE Plasma (yalnızca masaüstü, kde-applications YOK) ────────
plasma-desktop
plasma-workspace
plasma-nm
plasma-pa
sddm
konsole
dolphin
kate
spectacle

# ── Ses ─────────────────────────────────────────────────────────
pipewire
pipewire-alsa
pipewire-pulse
wireplumber
alsa-utils

# ── Grafik (yalnızca açık kaynak evrensel sürücü) ───────────────
mesa
mesa-utils
xf86-video-amdgpu
xf86-video-intel
vulkan-icd-loader

# ── Fontlar ─────────────────────────────────────────────────────
ttf-dejavu
noto-fonts
noto-fonts-emoji

# ── Yardımcı araçlar ────────────────────────────────────────────
sudo
archlinux-keyring
gnupg
git
htop
fastfetch
fuse2
unrar
zip
unzip

# ── Görünüm ─────────────────────────────────────────────────────
breeze
papirus-icon-theme

# ── Faz 2'ye ertelenenler (ISO'yu büyütür / AUR gerekir) ────────
# base-devel, linux-headers, kde-applications-meta, lib32-*, nvidia,
# calamares, neofetch, plymouth, kvantum, sof-firmware, gnome uygulamaları
