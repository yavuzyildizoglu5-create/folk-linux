# Folk Linux — Plymouth script teması
# Basit, Pillow benzeri script API'si kullanır.

logo.image = Image("folklinux-logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX((Window.GetWidth() - logo.image.GetWidth()) / 2);
logo.sprite.SetY((Window.GetHeight() - logo.image.GetHeight()) / 2 - 40);

progress_bar = Sprite();
progress_image = Image("progress.png");

fun refresh_progress(value) {
    progress_bar.SetImage(progress_image);
    progress_bar.SetX((Window.GetWidth() - progress_image.GetWidth()) / 2);
    progress_bar.SetY(Window.GetHeight() * 0.75);
}

fun OnShow() {
    refresh_progress(0);
}

fun OnProgress(progress) {
    refresh_progress(progress);
}

fun OnDone() {
    logo.sprite.SetOpacity(1.0);
}
